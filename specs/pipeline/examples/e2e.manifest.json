{
  "schema_version": "1",
  "test_level": "e2e",
  "target": "feedback-form",
  "generation": {
    "preset": "balanced",
    "selector_policy": "auto",
    "require_plan_case_comments": true,
    "emit_plan_markdown": true
  },
  "risks": ["Timing on list refresh"],
  "invariants": ["Submit button disabled or loading during submit"],
  "env_template": "E2E app URL: http://127.0.0.1:3000/ (root playwright.config.js use.baseURL + webServer npm run dev). Client dev server is Vite on port 3000 (client/vite.config.js), not Vite’s default 5173. In tests use await page.goto('/') or the same origin; do not use localhost:5173 unless you change the whole stack. Generated Playwright files are *.spec.js (plain JavaScript only — no TypeScript syntax).",
  "requirements": {
    "path": "specs/pipeline/examples/sample-requirements.md",
    "planner_mode": "full"
  },
  "page_snapshot": {
    "path": "specs/pipeline/examples/sample-page-snapshot.txt",
    "format": "a11y"
  },
  "policies": {
    "max_prompt_chars": {
      "total": 200000,
      "per_file": 60000,
      "openapi": 120000,
      "requirements": 80000
    },
    "forbidden_path_globs": []
  },
  "files": [
    {
      "path": "client/src/components/FeedbackForm.jsx",
      "role": "both",
      "priority": 5
    },
    {
      "path": "client/src/utils/validation.js",
      "role": "both",
      "priority": 4
    },
    {
      "path": "client/src/App.jsx",
      "role": "both",
      "priority": 3
    }
  ],
  "output_policy": {
    "primary_test_file": "tests/e2e/feedback-form.pipeline.example.spec.js"
  }
}
