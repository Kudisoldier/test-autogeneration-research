{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nir3.local/schemas/test-plan.schema.json",
  "title": "Structured test plan (planner output)",
  "type": "object",
  "required": ["schema_version", "test_level", "target", "cases"],
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "test_level": {
      "type": "string",
      "enum": [
        "unit_server",
        "unit_ui",
        "integration_server",
        "integration_ui",
        "e2e"
      ]
    },
    "target": { "type": "string" },
    "fixtures": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true }
    },
    "framework_hints": {
      "type": "object",
      "properties": {
        "runner": { "type": "string" },
        "libraries": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "steps", "assertions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-zA-Z0-9_-]+$" },
          "title": { "type": "string" },
          "preconditions": { "type": "array", "items": { "type": "string" } },
          "steps": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "assertions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "negative_paths": { "type": "array", "items": { "type": "string" } },
          "data": { "type": "object", "additionalProperties": true },
          "links": {
            "type": "object",
            "properties": {
              "requirement_ids": { "type": "array", "items": { "type": "string" } },
              "operation_ids": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": true
          },
          "flakiness_risks": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
